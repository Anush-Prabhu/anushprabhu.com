---
import '../styles/base.css'
import Desktop from '../components/desktop/Desktop'
import { Icon } from '../components/desktop/Icon'
import { site, profile } from '../data/profile'
import { getSiteData } from '../lib/content'
import { NAV, type AppId } from '../components/desktop/apps'
import { toJsonLd } from '../lib/structured-data'

interface Props {
  title?: string
  description?: string
  /** Which desktop app this page's content belongs to. */
  app: AppId
  /** Shown in the plain view's window-style frame, e.g. "~/experience". */
  path: string
  /** Structured data for this page (JSON-LD). */
  jsonLd?: unknown
}

const { title, description = site.description, app, path, jsonLd } = Astro.props
const ogImage = new URL('/og.png', site.url).href
const fullTitle = title ? `${title} — ${site.title}` : `${site.title} — security engineering, automation, applied AI`
// With build.format 'file', pathnames arrive as "/index.html" and "/experience.html"; URLs never show either.
const cleanPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/(.)\/$/, '$1') || '/'
const canonical = new URL(cleanPath, site.url).href
const current = cleanPath
const isHome = cleanPath === '/'
const data = await getSiteData()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f1620" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Anush Prabhu: security engineering, automation and applied AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={toJsonLd(jsonLd)} />}
    <script is:inline>
      // Runs before paint: mark JS available and, where the desktop will load (tablet and up), hide the plain
      // view while it starts. The CSS falls back to the plain view after 3 s if the desktop never mounts.
      // Keep the media query in sync with `client:media` below and ACTIVE_QUERY in Desktop.tsx.
      ;(function () {
        var d = document.documentElement
        d.setAttribute('data-js', '')
        var plain = false
        try {
          plain = localStorage.getItem('view') === 'plain'
        } catch (e) {}
        if (!plain && window.matchMedia('(min-width: 600px) and (min-height: 500px)').matches)
          d.setAttribute('data-view', 'pending')
      })()
    </script>
  </head>
  <body data-title={title ?? 'Home'} data-home={isHome ? '' : undefined}>
    <a class="skip-link plain" href="#content">
      Skip to content
    </a>
    <header class="plain plain-header">
      <div class="inner">
        <a class="brand" href="/">
          <b>{profile.user}</b>@{profile.host}
        </a>
        <nav class="plain-nav" aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={item.route} aria-current={current === item.route ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button class="open-desktop" type="button" data-open-desktop>
          Open desktop view
        </button>
        <button class="m-icon m-only js-only" type="button" data-m-open="search" aria-label="Search">
          <Icon name="search" size={20} />
        </button>
      </div>
    </header>
    <main id="content" class="plain plain-main">
      <div class="frame">
        <div class="frame-bar">
          {!isHome && (
            <a class="m-back m-only" href="/" aria-label="Back to home">
              <Icon name="back" size={20} />
            </a>
          )}
          <span aria-hidden="true">
            {profile.user}@{profile.host}: {path}
          </span>
        </div>
        <div class="frame-body">
          <slot />
        </div>
      </div>
    </main>
    <footer class="plain plain-footer">
      <nav aria-label="Site information">
        <ul>
          <li>
            <a href="/resume">Resume</a>
          </li>
          <li>
            <a href="/privacy">Privacy</a>
          </li>
          <li>
            <a href="/terms">Terms</a>
          </li>
          <li>
            <a href="/accessibility">Accessibility</a>
          </li>
        </ul>
      </nav>
      <p>
        © {new Date().getFullYear()} {profile.name}
      </p>
    </footer>

    <nav class="plain m-dock m-only" aria-label="Phone apps">
      <a href="/" aria-current={isHome ? 'page' : undefined}>
        <Icon name="home" size={22} />
        <span>Home</span>
      </a>
      <button type="button" class="js-only" data-m-open="terminal">
        <Icon name="terminal" size={22} />
        <span>Terminal</span>
      </button>
      <button type="button" class="js-only" data-m-open="search">
        <Icon name="search" size={22} />
        <span>Search</span>
      </button>
      <button type="button" class="js-only" data-m-open="recent">
        <Icon name="cards" size={22} />
        <span>Recent</span>
      </button>
    </nav>

    <Desktop client:media="(min-width: 600px) and (min-height: 500px)" initialApp={app} data={data} />

    <script>
      import { boot } from '../components/mobile/boot'
      boot()
    </script>
  </body>
</html>
