---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found" app="about" path="~/404">
  <div class="content">
    <h1>Page not found</h1>
    <p style="margin-top:10px">There's no page at this address. It may have moved, or the link may have a typo.</p>
    <div class="actions">
      <a class="btn primary" href="/">
        Go to the home page
      </a>
    </div>
  </div>
</Base>
