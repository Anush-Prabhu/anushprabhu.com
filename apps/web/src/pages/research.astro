---
import Base from '../layouts/Base.astro'
import ResearchContent from '../components/content/ResearchContent.astro'
import { getPublications } from '../lib/content'
import { scholarlyArticle } from '../lib/structured-data'

const jsonLd = (await getPublications())
  .filter((p) => p.data.status === 'published')
  .map((p) => scholarlyArticle({ title: p.data.title, isbn: p.data.isbn }))
---

<Base
  title="Research"
  jsonLd={jsonLd}
  app="research"
  path="~/research"
  description="Anush Prabhu's publication and research-oriented projects."
>
  <ResearchContent />
</Base>
