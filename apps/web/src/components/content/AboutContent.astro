---
import { CAMPAIGNS, GENERAL } from '../../data/campaigns'
import { profile } from '../../data/profile'
import { campaignLookup } from '../../lib/campaigns'
import { getEducation, getExperience, getProjects } from '../../lib/content'
import HomeIntro from './HomeIntro.astro'

interface Props {
  /** The home page is campaign-aware and adds recent work; /about adds education. */
  variant: 'home' | 'about'
}
const { variant } = Astro.props
const experience = await getExperience()
const projects = await getProjects()
const education = await getEducation()
const general = CAMPAIGNS.find((c) => c.id === GENERAL)!
const others = CAMPAIGNS.filter((c) => c.id !== GENERAL)
const lookup = campaignLookup()
---

<div class="content" data-app-content="about">
  {profile.placeholder && <span class="note">Placeholder text based on the resume</span>}
  <div class="whoami" aria-hidden="true">
    <div class="l1">
      (
      <b>
        {profile.user}㉿{profile.host}
      </b>
      )-[<span class="path">~/about</span>]
    </div>
    <div class="l2">
      <span class="cmd">whoami</span>
    </div>
  </div>
  <h1 class="name">{profile.name}</h1>
  <div data-campaign-slot="intro">
    <HomeIntro campaign={general} part="intro" experience={experience} projects={projects} />
  </div>
  <p class="meta" style="margin-top:16px;max-width:62ch">
    {profile.facts}
  </p>
  <slot name="after-intro" />

  <h2>What I work on</h2>
  <p>{profile.focus}</p>

  {variant === 'home' && (
    <>
      <div data-campaign-slot="featured">
        <HomeIntro campaign={general} part="featured" experience={experience} projects={projects} />
      </div>
      {others.map((c) => (
        <>
          <template data-campaign={c.id} data-slot="intro">
            <HomeIntro campaign={c} part="intro" experience={experience} projects={projects} />
          </template>
          <template data-campaign={c.id} data-slot="featured">
            <HomeIntro campaign={c} part="featured" experience={experience} projects={projects} />
          </template>
        </>
      ))}
    </>
  )}

  {variant === 'about' && (
    <>
      <h2>Education</h2>
      <ul class="list">
        {education.map((e) => (
          <li class="row">
            <p class="meta">{e.data.date}</p>
            <div>
              <h3>{e.data.degree}</h3>
              <p>
                {e.data.school}, {e.data.place}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </>
  )}
</div>

{variant === 'home' && <script is:inline define:vars={{ lookup }}>
  // Pick this visit's campaign from ?utm_campaign= (validated against a fixed table) and swap in its intro before
  // the page paints. Unknown or unsafe values keep the general intro. Remembered for the session only.
  ;(function () {
    try {
      var raw = new URLSearchParams(location.search).get('utm_campaign')
      var id = null
      if (raw !== null) {
        var v = raw.trim().toLowerCase()
        id = /^[a-z0-9_-]{1,40}$/.test(v) && Object.prototype.hasOwnProperty.call(lookup, v) ? lookup[v] : 'general'
        sessionStorage.setItem('campaign', id)
      } else {
        id = sessionStorage.getItem('campaign')
      }
      if (!id || id === 'general') return
      document.querySelectorAll('template[data-campaign="' + id + '"]').forEach(function (t) {
        var slot = document.querySelector('.plain [data-campaign-slot="' + t.getAttribute('data-slot') + '"]')
        if (slot) slot.replaceChildren(t.content.cloneNode(true))
      })
    } catch (e) {}
  })()
</script>}
