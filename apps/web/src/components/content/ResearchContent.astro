---
import { getProjects, getPublications } from '../../lib/content'
const publications = await getPublications()
const related = (await getProjects()).filter((p) => ['guardrailed-rag', 'provenance-guard', 'takemeter'].includes(p.id))
---

<div class="content" data-app-content="research">
  <h1>Research</h1>
  <h2>Published</h2>
  <ul class="list">
    {publications
      .filter((p) => p.data.status === 'published')
      .map((p) => (
        <li>
          <h3>{p.data.title}</h3>
          <p class="meta">
            {p.data.isbn && <>Online ISBN {p.data.isbn}</>}
            {p.data.teamSize && <> · team of {p.data.teamSize}</>}
          </p>
        </li>
      ))}
  </ul>
  <h2>Research-oriented projects</h2>
  <ul class="list">
    {related.map((p) => (
      <li>
        <h3>
          <a href={`/projects/${p.id}`}>{p.data.title}</a>
        </h3>
        <p>{p.data.summary}</p>
      </li>
    ))}
  </ul>
</div>
