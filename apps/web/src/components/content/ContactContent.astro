---
import { profile } from '../../data/profile'
---

<div class="content" data-app-content="contact">
  <h1>Contact</h1>
  <p class="lede" style="max-width:40ch">
    Email is the most direct way to reach me. I read every message.
  </p>
  <div class="actions">
    {profile.email && (
      <a class="btn primary" href={`mailto:${profile.email}`}>
        Email {profile.email}
      </a>
    )}
    <a class="btn" href={profile.linkedin} rel="noopener noreferrer" target="_blank">
      Message me on LinkedIn
    </a>
    <a class="btn" href={profile.github} rel="noopener noreferrer" target="_blank">
      See my GitHub
    </a>
  </div>
  <p class="meta" style="margin-top:18px">
    Based in {profile.location}. You can also <a href="/resume">view or save my resume</a>.
  </p>
</div>
